# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, never expose to the client.
# Not used yet in step 1, needed once notification/access-grant delivery
# (later build steps) call into Supabase from trusted server code.
SUPABASE_SERVICE_ROLE_KEY=
