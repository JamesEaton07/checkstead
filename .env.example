# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend API key — server-only, never expose to the client. Used both by
# `supabase config push` (custom SMTP for Supabase Auth's own emails) and
# directly by the app server (src/lib/email/resend.ts) for app-triggered
# emails like access-link invites and access-request notifications.
RESEND_API_KEY=

# Service role key — server-only, never expose to the client. Not currently
# used: server-side privilege escalation so far goes through security-definer
# Postgres functions (see supabase/migrations/0006, 0007) scoped to exactly
# what each one needs, rather than the service role's full bypass-RLS access.
SUPABASE_SERVICE_ROLE_KEY=
