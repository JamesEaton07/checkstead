# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend API key — server-only, never expose to the client. Used both by
# `supabase config push` (custom SMTP for Supabase Auth's own emails) and
# directly by the app server (src/lib/email/resend.ts) for app-triggered
# emails like access-link invites and access-request notifications.
RESEND_API_KEY=

# Service role key — server-only, never expose to the client. Used only for
# the narrow set of operations RLS structurally can't cover (see
# src/lib/supabase/service-role.ts) — most privileged server-side work goes
# through security-definer Postgres functions instead, scoped to exactly
# what each one needs.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret gating /api/cron/check-in-reminders — generate a long random
# value (e.g. `openssl rand -hex 32`) and set the same value as a Vercel
# project env var so Vercel's Cron invocations authenticate correctly.
CRON_SECRET=
